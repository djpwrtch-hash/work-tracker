# Root .env — used by docker-compose.yml.
# For running the server directly with Node, copy server/.env.example to server/.env
# instead. Do not commit either file.

# MySQL (docker compose service)
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=hr

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=change_me_access_32_chars_min__________________
JWT_REFRESH_SECRET=change_me_refresh_32_chars_min_________________
ADMIN_EMAIL=admin@power-tech.group
ADMIN_PASSWORD=change_me_admin_12+chars!

# Public origin. For Railway use:
#   APP_URL=https://${{RAILWAY_PUBLIC_DOMAIN}}
#   CORS_ORIGIN=https://${{RAILWAY_PUBLIC_DOMAIN}}
#   COOKIE_SECURE=true
CORS_ORIGIN=http://localhost:42780
APP_URL=http://localhost:42780
TRUST_PROXY=1
COOKIE_SECURE=false
# strict (default) | lax | none
COOKIE_SAME_SITE=strict
# Business timezone for "today", attendance dates and scheduled jobs.
APP_TIMEZONE=Asia/Kolkata
# Off by default in production. When true, /api-docs requires HTTP Basic auth
# (username "admin", password ADMIN_PASSWORD).
ENABLE_API_DOCS=false

# Optional
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@power-tech.group
